<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D1A">

    <!-- TOP BAR with back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#12122A">

        <ImageButton
            android:id="@+id/btnNazaj"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="#8ECAE6"
            android:contentDescription="Nazaj" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Dodaj vnos"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E1E3F" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FORM CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#1C1C3A"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- CURRENCY -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VALUTA"
                        android:textColor="#A5B4FC"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <Spinner
                        android:id="@+id/spinnerValuta"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="16dp"
                        android:popupBackground="#1C1C3A" />

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="20dp"
                        android:background="#2A2A50" />

                    <!-- AMOUNT -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZNESEK"
                        android:textColor="#A5B4FC"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <EditText
                        android:id="@+id/etZnesek"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/edittext_background"
                        android:hint="npr. 500"
                        android:inputType="numberDecimal"
                        android:paddingStart="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B6D9A"
                        android:textSize="20sp" />

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="20dp"
                        android:background="#2A2A50" />

                    <!-- NOTE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPOMBA (neobvezno)"
                        android:textColor="#A5B4FC"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <EditText
                        android:id="@+id/etOpomba"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/edittext_background"
                        android:hint="npr. Potovanje, varčevanje..."
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B6D9A" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STATUS TEXT -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#8ECAE6"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnShrani"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#E94560"
                android:text="SHRANI"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>